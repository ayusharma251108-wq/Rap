<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RHYME LAB — Advanced Multisyllabic Rap Training Web App</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        darkBg: '#0b0f19',
                        cardBg: '#121826',
                        cardHover: '#1a2338',
                        neonPurple: '#a855f7',
                        neonBlue: '#3b82f6',
                        neonPink: '#ec4899',
                        neonGreen: '#10b981',
                        borderDark: '#1e293b'
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0b0f19;
            color: #f8fafc;
        }
        .mono {
            font-family: 'JetBrains Mono', monospace;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0f19;
        }
        ::-webkit-scrollbar-thumb {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b82f6;
        }
        .glow-purple {
            box-shadow: 0 0 25px rgba(168, 85, 247, 0.25);
        }
        .glow-blue {
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.25);
        }
        .glow-green {
            box-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
        }
        .gradient-text {
            background: linear-gradient(135deg, #c084fc 0%, #38bdf8 50%, #4ade80 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        @keyframes pulseGlow {
            0%, 100% { opacity: 0.6; }
            50% { opacity: 1; }
        }
        .animate-pulse-slow {
            animation: pulseGlow 3s infinite ease-in-out;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-purple-500 selection:text-white">

    <!-- TOP NAVIGATION BAR -->
    <header class="sticky top-0 z-50 bg-darkBg/90 backdrop-blur-md border-b border-borderDark px-4 lg:px-8 py-3 flex items-center justify-between">
        <div class="flex items-center space-x-3 cursor-pointer" onclick="switchTab('dashboard')">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-blue-600 to-emerald-500 flex items-center justify-center shadow-lg shadow-purple-500/30">
                <i class="fa-solid fa-microphone-lines text-white text-lg"></i>
            </div>
            <div>
                <h1 class="font-extrabold text-xl tracking-wider gradient-text uppercase">Rhyme Lab</h1>
                <p class="text-xs text-slate-400 mono">Hinglish / Hindi Multisyllabic Gym v2.6</p>
            </div>
        </div>

        <!-- Navigation Tabs (Desktop) -->
        <nav class="hidden md:flex items-center space-x-1 bg-cardBg p-1 rounded-xl border border-borderDark text-sm font-medium">
            <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center space-x-2">
                <i class="fa-solid fa-house-chimney"></i><span>Dashboard</span>
            </button>
            <button onclick="switchTab('practice')" id="nav-practice" class="nav-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center space-x-2">
                <i class="fa-solid fa-dumbbell"></i><span>Practice Gym</span>
            </button>
            <button onclick="switchTab('wordplay')" id="nav-wordplay" class="nav-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center space-x-2">
                <i class="fa-solid fa-brain"></i><span>Wordplay Lab</span>
            </button>
            <button onclick="switchTab('dictionary')" id="nav-dictionary" class="nav-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center space-x-2">
                <i class="fa-solid fa-book-bookmark"></i><span>Rhyme Bank</span>
            </button>
            <button onclick="switchTab('analytics')" id="nav-analytics" class="nav-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center space-x-2">
                <i class="fa-solid fa-chart-line"></i><span>Analytics</span>
            </button>
            <button onclick="switchTab('settings')" id="nav-settings" class="nav-btn px-4 py-2 rounded-lg transition-all text-slate-300 hover:text-white flex items-center space-x-2">
                <i class="fa-solid fa-gear"></i><span>Settings</span>
            </button>
        </nav>

        <!-- Right Quick Actions -->
        <div class="flex items-center space-x-3">
            <div id="api-status-pill" class="hidden sm:flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-medium bg-red-950/60 border border-red-800/80 text-red-400">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                <span>API Key Needed</span>
            </div>
            <button onclick="switchTab('settings')" class="p-2.5 rounded-xl bg-cardBg hover:bg-cardHover border border-borderDark text-slate-300 hover:text-white transition-all">
                <i class="fa-solid fa-key"></i>
            </button>
            <button onclick="openMobileMenu()" class="md:hidden p-2.5 rounded-xl bg-cardBg hover:bg-cardHover border border-borderDark text-slate-300">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
    </header>

    <!-- MOBILE MENU MODAL -->
    <div id="mobile-menu" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex flex-col p-6 space-y-4">
        <div class="flex justify-between items-center pb-4 border-b border-borderDark">
            <h2 class="text-xl font-bold gradient-text">Menu</h2>
            <button onclick="closeMobileMenu()" class="text-slate-400 hover:text-white text-2xl"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <button onclick="switchTab('dashboard'); closeMobileMenu();" class="flex items-center space-x-3 p-3 rounded-xl bg-cardBg text-left font-medium"><i class="fa-solid fa-house-chimney text-purple-400"></i><span>Dashboard</span></button>
        <button onclick="switchTab('practice'); closeMobileMenu();" class="flex items-center space-x-3 p-3 rounded-xl bg-cardBg text-left font-medium"><i class="fa-solid fa-dumbbell text-blue-400"></i><span>Practice Gym</span></button>
        <button onclick="switchTab('wordplay'); closeMobileMenu();" class="flex items-center space-x-3 p-3 rounded-xl bg-cardBg text-left font-medium"><i class="fa-solid fa-brain text-emerald-400"></i><span>Wordplay Lab</span></button>
        <button onclick="switchTab('dictionary'); closeMobileMenu();" class="flex items-center space-x-3 p-3 rounded-xl bg-cardBg text-left font-medium"><i class="fa-solid fa-book-bookmark text-pink-400"></i><span>Rhyme Bank</span></button>
        <button onclick="switchTab('analytics'); closeMobileMenu();" class="flex items-center space-x-3 p-3 rounded-xl bg-cardBg text-left font-medium"><i class="fa-solid fa-chart-line text-amber-400"></i><span>Analytics</span></button>
        <button onclick="switchTab('settings'); closeMobileMenu();" class="flex items-center space-x-3 p-3 rounded-xl bg-cardBg text-left font-medium"><i class="fa-solid fa-gear text-slate-400"></i><span>Settings & API Key</span></button>
    </div>

    <!-- MAIN APP CONTAINER -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 lg:px-8 py-6">

        <!-- ================= TAB 1: DASHBOARD ================= -->
        <div id="tab-dashboard" class="tab-content space-y-8">
            <!-- Hero Banner -->
            <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-900/40 via-blue-900/30 to-emerald-900/30 border border-borderDark p-8 lg:p-10 glow-purple">
                <div class="absolute -right-10 -bottom-10 opacity-10 pointer-events-none text-9xl">
                    <i class="fa-solid fa-headphones"></i>
                </div>
                <div class="max-w-3xl space-y-4">
                    <span class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/35 uppercase tracking-wider">Hinglish Multisyllabic Gym</span>
                    <h2 class="text-3xl lg:text-5xl font-extrabold tracking-tight text-white">Master The Art Of <span class="gradient-text">Complex Rhymes</span></h2>
                    <p class="text-slate-300 text-base lg:text-lg leading-relaxed">
                        Train spontaneous flow, internal rhymes, multisyllabic syllable accuracy, and Hindi/Hinglish wordplay with real AI phonetic evaluation. Jump directly to any of the 14 syllable-count problem categories instantly.
                    </p>
                    <div class="flex flex-wrap gap-4 pt-2">
                        <button onclick="switchTab('practice'); selectProblem(4);" class="px-6 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-blue-600 text-white font-semibold shadow-lg shadow-purple-600/30 hover:opacity-95 transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-play"></i><span>Start Quick Practice (4-Syllable)</span>
                        </button>
                        <button onclick="switchTab('settings')" class="px-6 py-3 rounded-xl bg-cardBg hover:bg-cardHover border border-borderDark text-slate-200 font-medium transition-all flex items-center space-x-2">
                            <i class="fa-solid fa-key text-purple-400"></i><span>Configure Gemini API Key</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats Overview Bar -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-cardBg border border-borderDark rounded-2xl p-5">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-semibold tracking-wider">Total Attempted</span>
                        <i class="fa-solid fa-layer-group text-purple-400"></i>
                    </div>
                    <div id="stat-total-attempted" class="text-3xl font-extrabold text-white mono">0</div>
                    <div class="text-xs text-slate-500 mt-1">Exercises logged</div>
                </div>
                <div class="bg-cardBg border border-borderDark rounded-2xl p-5">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-semibold tracking-wider">Overall Accuracy</span>
                        <i class="fa-solid fa-bullseye text-blue-400"></i>
                    </div>
                    <div id="stat-overall-accuracy" class="text-3xl font-extrabold text-white mono">0%</div>
                    <div class="text-xs text-slate-500 mt-1">Phonetic & syllable match</div>
                </div>
                <div class="bg-cardBg border border-borderDark rounded-2xl p-5">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-semibold tracking-wider">Best Rhyme Score</span>
                        <i class="fa-solid fa-trophy text-emerald-400"></i>
                    </div>
                    <div id="stat-best-score" class="text-3xl font-extrabold text-white mono">0/100</div>
                    <div class="text-xs text-slate-500 mt-1">Personal peak score</div>
                </div>
                <div class="bg-cardBg border border-borderDark rounded-2xl p-5">
                    <div class="flex items-center justify-between text-slate-400 mb-2">
                        <span class="text-xs uppercase font-semibold tracking-wider">Saved in Bank</span>
                        <i class="fa-solid fa-bookmark text-pink-400"></i>
                    </div>
                    <div id="stat-saved-bank" class="text-3xl font-extrabold text-white mono">0</div>
                    <div class="text-xs text-slate-500 mt-1">Favorite bars & chains</div>
                </div>
            </div>

            <!-- 14 INDEPENDENT PROBLEMS SECTION -->
            <div class="space-y-4">
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-2">
                    <div>
                        <h3 class="text-xl font-bold text-white flex items-center space-x-2">
                            <i class="fa-solid fa-list-ol text-purple-400"></i>
                            <span>The 14 Independent Syllable Problems</span>
                        </h3>
                        <p class="text-sm text-slate-400">Non-sequential, freely selectable challenges. Pick any syllable count instantly.</p>
                    </div>
                    <div class="flex items-center space-x-2 text-xs text-slate-400 bg-cardBg px-3 py-1.5 rounded-xl border border-borderDark">
                        <i class="fa-solid fa-circle-info text-blue-400"></i>
                        <span>Click any card to start practicing that exact syllable count</span>
                    </div>
                </div>

                <!-- 14 Problems Grid -->
                <div id="problems-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-3">
                    <!-- Injected dynamically via JavaScript -->
                </div>
            </div>

            <!-- Quick Practice Modes Row -->
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4 pt-4">
                <div onclick="switchTab('practice'); setPracticeMode('find_rhyme');" class="bg-cardBg hover:bg-cardHover border border-borderDark rounded-2xl p-5 cursor-pointer transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </div>
                    <h4 class="font-bold text-white mb-1">Find The Rhyme</h4>
                    <p class="text-xs text-slate-400 leading-relaxed">Match target syllable count with strict phonetic alignment.</p>
                </div>
                <div onclick="switchTab('practice'); setPracticeMode('completion');" class="bg-cardBg hover:bg-cardHover border border-borderDark rounded-2xl p-5 cursor-pointer transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-puzzle-piece"></i>
                    </div>
                    <h4 class="font-bold text-white mb-1">Rhyme Completion</h4>
                    <p class="text-xs text-slate-400 leading-relaxed">Complete incomplete Hinglish rap bars naturally.</p>
                </div>
                <div onclick="switchTab('practice'); setPracticeMode('chain');" class="bg-cardBg hover:bg-cardHover border border-borderDark rounded-2xl p-5 cursor-pointer transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/20 text-emerald-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-link"></i>
                    </div>
                    <h4 class="font-bold text-white mb-1">Rhyme Chain</h4>
                    <p class="text-xs text-slate-400 leading-relaxed">Generate 3 to 20 continuous non-repeating rhyming phrases.</p>
                </div>
                <div onclick="switchTab('practice'); setPracticeMode('scheme');" class="bg-cardBg hover:bg-cardHover border border-borderDark rounded-2xl p-5 cursor-pointer transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-pink-500/20 text-pink-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-feather-pointed"></i>
                    </div>
                    <h4 class="font-bold text-white mb-1">Scheme Builder</h4>
                    <p class="text-xs text-slate-400 leading-relaxed">Construct connected bars with AABB, ABAB, or custom schemes.</p>
                </div>
                <div onclick="switchTab('practice'); setPracticeMode('reflex');" class="bg-cardBg hover:bg-cardHover border border-borderDark rounded-2xl p-5 cursor-pointer transition-all group">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <h4 class="font-bold text-white mb-1">Freestyle Reflex</h4>
                    <p class="text-xs text-slate-400 leading-relaxed">Timed countdown challenge to spit rapid valid rhymes.</p>
                </div>
            </div>
        </div>

        <!-- ================= TAB 2: PRACTICE GYM ================= -->
        <div id="tab-practice" class="tab-content hidden space-y-6">
            <!-- Practice Header Bar -->
            <div class="bg-cardBg border border-borderDark rounded-2xl p-4 lg:p-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
                <div class="flex items-center space-x-4">
                    <div id="current-problem-badge" class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-600 to-blue-600 flex flex-col items-center justify-center text-white font-extrabold shadow-lg">
                        <span id="badge-syllable-num" class="text-xl mono">4</span>
                        <span class="text-[9px] uppercase tracking-wider text-purple-200">Syllable</span>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <h3 id="current-problem-title" class="text-xl font-bold text-white">Problem 4 — Four-Syllable Rhyming</h3>
                            <span id="mode-badge-label" class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-500/20 text-purple-300 border border-purple-500/35">Find The Rhyme</span>
                        </div>
                        <p class="text-xs text-slate-400 mt-1">Select any other problem instantly below or change practice mode.</p>
                    </div>
                </div>

                <!-- Mode Selector & Quick Problem Jump -->
                <div class="flex flex-wrap items-center gap-2">
                    <select id="practice-mode-select" onchange="changePracticeMode(this.value)" class="bg-darkBg border border-borderDark rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-purple-500">
                        <option value="find_rhyme">Mode 1: Find The Rhyme</option>
                        <option value="completion">Mode 2: Rhyme Completion</option>
                        <option value="chain">Mode 3: Rhyme Chain Challenge</option>
                        <option value="scheme">Mode 4: Rhyme Scheme Builder</option>
                        <option value="reflex">Mode 5: Freestyle Reflex</option>
                    </select>

                    <select id="topic-select" class="bg-darkBg border border-borderDark rounded-xl px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-purple-500">
                        <option value="Random">Topic: Random / Any</option>
                        <option value="Street life">Street Life / Struggle</option>
                        <option value="Success">Success & Ambition</option>
                        <option value="Philosophy">Philosophy & Mind</option>
                        <option value="Technology">Technology & AI</option>
                        <option value="History">History & Myth</option>
                        <option value="Relationships">Relationships & Trust</option>
                    </select>

                    <button onclick="generateNewExercise()" class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-sm font-semibold shadow-lg shadow-purple-600/20 transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-rotate"></i><span>New Exercise</span>
                    </button>
                </div>
            </div>

            <!-- Direct 1-14 Problem Quick Bar -->
            <div class="bg-cardBg/60 border border-borderDark rounded-2xl p-3 flex items-center space-x-2 overflow-x-auto">
                <span class="text-xs font-bold text-slate-400 uppercase tracking-wider px-2 whitespace-nowrap">Jump Problem:</span>
                <div id="quick-problem-pills" class="flex items-center space-x-2">
                    <!-- Injected via JS -->
                </div>
            </div>

            <!-- Main Exercise Arena -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                <!-- Left Column: Target & Input Area -->
                <div class="lg:col-span-7 space-y-6">
                    <!-- Target Card -->
                    <div class="bg-cardBg border border-borderDark rounded-3xl p-6 lg:p-8 space-y-6 relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-purple-600/5 rounded-full blur-2xl pointer-events-none"></div>
                        
                        <div class="flex items-center justify-between">
                            <div class="flex items-center space-x-2 text-xs font-semibold text-purple-400 tracking-wider uppercase">
                                <i class="fa-solid fa-bullseye"></i>
                                <span id="target-category-label">Target Challenge</span>
                            </div>
                            <div id="timer-display" class="hidden items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/20 text-amber-300 border border-amber-500/30 text-xs font-mono font-bold">
                                <i class="fa-solid fa-stopwatch"></i>
                                <span id="timer-countdown">60s</span>
                            </div>
                        </div>

                        <div class="space-y-2">
                            <div class="text-xs text-slate-400 uppercase tracking-wider font-mono">Target Phrase / Prompt:</div>
                            <div id="target-phrase-text" class="text-2xl lg:text-3xl font-extrabold text-white mono bg-darkBg/60 p-5 rounded-2xl border border-borderDark">
                                Loading target phrase...
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
                            <div class="bg-darkBg/60 border border-borderDark p-3 rounded-xl">
                                <span class="text-slate-400 block mb-1">Required Syllables</span>
                                <span id="target-syllable-count" class="font-bold text-purple-400 text-base mono">4</span>
                            </div>
                            <div class="bg-darkBg/60 border border-borderDark p-3 rounded-xl">
                                <span class="text-slate-400 block mb-1">Phonetic Focus</span>
                                <span id="target-phonetic-hint" class="font-bold text-blue-400 text-sm mono">Vowel Match</span>
                            </div>
                            <div class="bg-darkBg/60 border border-borderDark p-3 rounded-xl col-span-2 sm:col-span-1">
                                <span class="text-slate-400 block mb-1">Theme / Topic</span>
                                <span id="target-topic-display" class="font-bold text-emerald-400 text-sm truncate block">Street Life</span>
                            </div>
                        </div>

                        <!-- Hint Box (Collapsible) -->
                        <div>
                            <button onclick="toggleHint()" class="text-xs text-purple-400 hover:text-purple-300 font-medium flex items-center space-x-1.5">
                                <i class="fa-solid fa-lightbulb"></i>
                                <span id="hint-toggle-text">Show Expert Hint / Example Structure</span>
                            </button>
                            <div id="hint-box" class="hidden mt-3 p-4 rounded-xl bg-purple-950/30 border border-purple-800/40 text-xs text-purple-200 leading-relaxed mono">
                                <!-- Hint injected here -->
                            </div>
                        </div>
                    </div>

                    <!-- User Answer Input Card -->
                    <div class="bg-cardBg border border-borderDark rounded-3xl p-6 lg:p-8 space-y-4">
                        <div class="flex items-center justify-between">
                            <label for="user-answer-input" class="text-sm font-bold text-white flex items-center space-x-2">
                                <i class="fa-solid fa-pen-nib text-purple-400"></i>
                                <span id="input-label-text">Your Rhyming Answer (Hinglish / Hindi):</span>
                            </label>
                            <span class="text-xs text-slate-400 mono" id="user-syllable-counter">Syllables: 0</span>
                        </div>

                        <textarea id="user-answer-input" rows="3" oninput="updateSyllableCounter()" placeholder="Apna rhyme yahan likhein (e.g., 'khooni mausam' or multi-syllable bar)..." class="w-full bg-darkBg border border-borderDark rounded-2xl p-4 text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 font-mono text-base resize-none"></textarea>

                        <div class="flex flex-wrap items-center justify-between gap-3 pt-2">
                            <div class="flex items-center space-x-2">
                                <button onclick="saveCurrentToDictionary()" class="px-4 py-2.5 rounded-xl bg-cardBg hover:bg-cardHover border border-borderDark text-slate-300 hover:text-white text-xs font-semibold transition-all flex items-center space-x-2">
                                    <i class="fa-solid fa-bookmark text-pink-400"></i><span>Save to Rhyme Bank</span>
                                </button>
                                <button onclick="clearInput()" class="px-4 py-2.5 rounded-xl bg-cardBg hover:bg-cardHover border border-borderDark text-slate-400 hover:text-slate-200 text-xs font-semibold transition-all">
                                    Clear
                                </button>
                            </div>
