    <!-- APPLICATION JAVASCRIPT LOGIC -->
    <script>
        // ================= STATE MANAGEMENT =================
        let appState = {
            apiKey: localStorage.getItem('rhyme_lab_gemini_key') || '',
            model: localStorage.getItem('rhyme_lab_model') || 'gemini-2.5-flash',
            currentTab: 'dashboard',
            currentProblem: 4, // 1 to 14
            currentMode: 'find_rhyme', // find_rhyme, completion, chain, scheme, reflex
            currentTopic: 'Random',
            timerDuration: 60,
            timerInterval: null,
            exercisesAttempted: JSON.parse(localStorage.getItem('rhyme_lab_history') || '[]'),
            savedBank: JSON.parse(localStorage.getItem('rhyme_lab_bank') || '[]'),
            currentExercise: null,
            wordplayExercise: null
        };

        // 14 Problem Metadata Definitions
        const problemsMeta = Array.from({length: 14}, (_, i) => {
            const num = i + 1;
            const names = [
                "One-Syllable Rhyming", "Two-Syllable Rhyming", "Three-Syllable Rhyming",
                "Four-Syllable Rhyming", "Five-Syllable Rhyming", "Six-Syllable Rhyming",
                "Seven-Syllable Rhyming", "Eight-Syllable Rhyming", "Nine-Syllable Rhyming",
                "Ten-Syllable Rhyming", "Eleven-Syllable Rhyming", "Twelve-Syllable Rhyming",
                "Thirteen-Syllable Rhyming", "Fourteen-Syllable Rhyming"
            ];
            return {
                number: num,
                title: names[i],
                description: `${num}-syllable strict phonetic target alignment in Hinglish.`
            };
        });

        // Initialize App on DOM Load
        document.addEventListener('DOMContentLoaded', () => {
            if (appState.apiKey) {
                document.getElementById('api-key-input').value = appState.apiKey;
                updateApiStatus(true, 'API Key Loaded from Storage');
            }
            document.getElementById('gemini-model-select').value = appState.model;
            
            renderProblemsGrid();
            renderQuickPills();
            updateDashboardStats();
            renderRhymeBank();
            renderAnalyticsProblems();
        });

        // ================= NAVIGATION =================
        function switchTab(tabId) {
            appState.currentTab = tabId;
            document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('bg-purple-600/20', 'text-white', 'border', 'border-purple-500/30');
                btn.classList.add('text-slate-300');
            });
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) {
                activeNav.classList.remove('text-slate-300');
                activeNav.classList.add('bg-purple-600/20', 'text-white', 'border', 'border-purple-500/30');
            }
            window.scrollTo({ top: 0, behavior: 'smooth' });
            if (tabId === 'practice') {
                if (!appState.currentExercise) {
                    generateNewExercise();
                }
            } else if (tabId === 'analytics') {
                renderAnalyticsProblems();
            }
        }

        function openMobileMenu() {
            document.getElementById('mobile-menu').classList.remove('hidden');
        }
        function closeMobileMenu() {
            document.getElementById('mobile-menu').classList.add('hidden');
        }

        // ================= API KEY & SETTINGS =================
        function toggleApiKeyVisibility() {
            const input = document.getElementById('api-key-input');
            const icon = document.getElementById('eye-icon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        function saveApiKey() {
            const key = document.getElementById('api-key-input').value.trim();
            const model = document.getElementById('gemini-model-select').value;
            if (!key) {
                alert('Please enter a valid Gemini API key.');
                return;
            }
            appState.apiKey = key;
            appState.model = model;
            localStorage.setItem('rhyme_lab_gemini_key', key);
            localStorage.setItem('rhyme_lab_model', model);
            updateApiStatus(true, 'API Key Saved Successfully');
            alert('Gemini API key saved securely in browser storage.');
        }

        function deleteApiKey() {
            if (confirm('Are you sure you want to delete your stored Gemini API key?')) {
                appState.apiKey = '';
                localStorage.removeItem('rhyme_lab_gemini_key');
                document.getElementById('api-key-input').value = '';
                updateApiStatus(false, 'API Key Deleted');
            }
        }

        function updateApiStatus(connected, message) {
            const pill = document.getElementById('api-status-pill');
            const statusText = document.getElementById('api-connection-status');
            if (connected) {
                pill.className = 'hidden sm:flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-medium bg-emerald-950/60 border border-emerald-800/80 text-emerald-400';
                pill.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>API Ready</span>`;
                if (statusText) {
                    statusText.className = 'text-emerald-400 flex items-center space-x-1.5';
                    statusText.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>${message}</span>`;
                }
            } else {
                pill.className = 'hidden sm:flex items-center space-x-2 px-3 py-1 rounded-full text-xs font-medium bg-red-950/60 border border-red-800/80 text-red-400';
                pill.innerHTML = `<span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span><span>API Key Needed</span>`;
                if (statusText) {
                    statusText.className = 'text-red-400 flex items-center space-x-1.5';
                    statusText.innerHTML = `<span class="w-2 h-2 rounded-full bg-red-500"></span><span>${message}</span>`;
                }
            }
        }

