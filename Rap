                    </div>
                    <div class="w-full h-2.5 bg-cardBg rounded-full overflow-hidden border border-borderDark">
                        <div class="h-full bg-gradient-to-r from-purple-600 to-blue-500 rounded-full transition-all duration-500" style="width: ${avgScore}%;"></div>
                    </div>
                `;
                container.appendChild(row);
            });
        }

        function startReflexTimer() {
            if (appState.timerInterval) clearInterval(appState.timerInterval);
            let timeLeft = appState.timerDuration;
            const timerEl = document.getElementById('timer-countdown');
            timerEl.textContent = timeLeft + 's';
            appState.timerInterval = setInterval(() => {
                timeLeft--;
                timerEl.textContent = timeLeft + 's';
                if (timeLeft <= 0) {
                    clearInterval(appState.timerInterval);
                    alert('Freestyle Reflex countdown finished! Check your score.');
                }
            }, 1000);
        }

        // ================= BACKUP & DATA MANAGEMENT =================
        function exportAllData() {
            const backup = {
                history: appState.exercisesAttempted,
                bank: appState.savedBank,
                timestamp: new Date().toISOString()
            };
            const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(backup, null, 2));
            const anchor = document.createElement('a');
            anchor.href = dataStr;
            anchor.download = `rhyme_lab_full_backup_${Date.now()}.json`;
            document.body.appendChild(anchor);
            anchor.click();
            anchor.remove();
        }

        function clearAllHistory() {
            if (confirm('Are you sure you want to clear all practice history? This cannot be undone.')) {
                appState.exercisesAttempted = [];
                localStorage.removeItem('rhyme_lab_history');
                updateDashboardStats();
                renderAnalyticsProblems();
                alert('Practice history cleared.');
            }
        }
    </script>
</body>
</html>
